{
  "name": "agent-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-ui/storybook dev",
    "build-storybook": "pnpm --filter @agent-ui/storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@agent-ui/figma-sync": "workspace:*",
    "@agent-ui/machines": "workspace:*",
    "@agent-ui/policy": "workspace:*",
    "@agent-ui/react": "workspace:*",
    "@agent-ui/runtime-live": "workspace:*",
    "@agent-ui/runtime-mock": "workspace:*",
    "@agent-ui/schema": "workspace:*",
    "@agent-ui/tokens": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
